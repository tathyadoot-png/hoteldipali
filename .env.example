# Canonical site URL used for metadata, sitemap and canonical tags
NEXT_PUBLIC_SITE_URL=
# Hosted form endpoint that EnquiryForm submissions are posted to
NEXT_PUBLIC_FORM_ENDPOINT=
# Access key / token required by the hosted form endpoint
NEXT_PUBLIC_FORM_ACCESS_KEY=
# WhatsApp number (international format, no symbols) used to build wa.me links
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Third-party booking engine URL; when unset, booking CTAs fall back to WhatsApp
NEXT_PUBLIC_BOOKING_ENGINE_URL=
# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA4_ID=
# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# Google Ads conversion ID
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Feature flag: enable the subtle post-6pm dusk tint on the paper surface
NEXT_PUBLIC_ENABLE_DUSK_TINT=

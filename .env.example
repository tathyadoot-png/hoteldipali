# Canonical site URL used for metadata, sitemap and canonical tags
NEXT_PUBLIC_SITE_URL=
# Hosted form endpoint that EnquiryForm submissions are posted to.
# The enquiry recipient for the current setup is tathyadoot@gmail.com. The provider,
# not this code, decides where mail goes — configure it there:
#   Web3Forms (recommended): create an access key for tathyadoot@gmail.com at
#     web3forms.com, then set NEXT_PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
#     and NEXT_PUBLIC_FORM_ACCESS_KEY=<that key>. The key is designed to be public.
#   FormSubmit: NEXT_PUBLIC_FORM_ENDPOINT=https://formsubmit.co/ajax/tathyadoot@gmail.com
#     (no key; confirm the activation email first; the address is then visible in the
#     page's code, so prefer FormSubmit's random alias once activated).
# After setting it, rebuild and send ONE real test enquiry to confirm delivery.
# Empty = forms show "Online enquiries aren't connected yet" with call / WhatsApp.
NEXT_PUBLIC_FORM_ENDPOINT=
# Access key / token required by the hosted form endpoint (Web3Forms: see above)
NEXT_PUBLIC_FORM_ACCESS_KEY=
# WhatsApp number (international format, no symbols) used to build wa.me links
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Third-party booking engine URL; when unset, booking CTAs fall back to WhatsApp
NEXT_PUBLIC_BOOKING_ENGINE_URL=
# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA4_ID=
# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# Google Ads conversion ID
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Feature flag: enable the subtle post-6pm dusk tint on the paper surface
NEXT_PUBLIC_ENABLE_DUSK_TINT=
